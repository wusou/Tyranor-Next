+    #[test]
+    fn alternating_large_and_small_windows_reuse_their_exchange_buffers() {
+        let mut small = vec![0; WINDOW_BYTES];
+        for (index, byte) in small[..16].iter_mut().enumerate() {
+            *byte = if index % 2 == 0 { 0 } else { index as u8 };
+        }
+        let large = vec![0xA5; WINDOW_BYTES];
+        let mut live = large.clone();
+        let mut saved = LocalWindow {
+            bytes: small[..16].to_vec(),
+            data_len: 16,
+            data_spans: RegionSpans::prefix(16),
+            code_spans: RegionSpans::default(),
+        };
+        let mut scratch = Vec::with_capacity(WINDOW_BYTES);
+        let small_pointer = saved.bytes.as_ptr();
+        let large_pointer = scratch.as_ptr();
+        let small_capacity = saved.bytes.capacity();
+        let large_capacity = scratch.capacity();
+        let mut outgoing = [
+            RegionSpans::full(REGION_BYTES),
+            RegionSpans::full(CODE_BYTES),
+        ];
+        for index in 0..6 {
+            let incoming = saved.spans();
+            saved.exchange_spanned(&mut live, &mut scratch, outgoing);
+            outgoing = incoming;
+            let (expected, saved_pointer, scratch_pointer, saved_capacity, scratch_capacity) =
+                if index % 2 == 0 {
+                    (&small, large_pointer, small_pointer, large_capacity, small_capacity)
+                } else {
+                    (&large, small_pointer, large_pointer, small_capacity, large_capacity)
+                };
+            assert_eq!(&live, expected);
+            assert_eq!(saved.bytes.as_ptr(), saved_pointer);
+            assert_eq!(scratch.as_ptr(), scratch_pointer);
+            assert_eq!(saved.bytes.capacity(), saved_capacity);
+            assert_eq!(scratch.capacity(), scratch_capacity);
+            assert!(scratch.is_empty());
+        }
