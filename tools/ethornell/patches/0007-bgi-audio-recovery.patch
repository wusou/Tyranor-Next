new file mode 100644
--- /dev/null
+++ b/crates/ethornell-audio/src/android.rs
@@ -0,0 +1,148 @@
+//! Android can report the same disconnection both before and after closing
+//! an Oboe stream. Coalesce those callbacks and reopen on an owning thread.
+use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};
+use cpal::{Device, Stream, StreamConfig};
+use kira::manager::backend::{Backend, Renderer};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, mpsc};
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+type Error = Box<dyn std::error::Error + Send + Sync>;
+const RETRY_INTERVAL: Duration = Duration::from_millis(250);
+
+pub struct AndroidBackend {
+    initial_device: Option<(Device, StreamConfig)>,
+    stop: Arc<AtomicBool>,
+    worker: Option<JoinHandle<()>>,
+}
+
+impl Backend for AndroidBackend {
+    type Settings = ();
+    type Error = Error;
+
+    fn setup(_: ()) -> Result<(Self, u32), Error> {
+        let (device, config) = output_device()?;
+        let rate = config.sample_rate.0;
+        Ok((
+            Self {
+                initial_device: Some((device, config)),
+                stop: Arc::new(AtomicBool::new(false)),
+                worker: None,
+            },
+            rate,
+        ))
+    }
+
+    fn start(&mut self, renderer: Renderer) -> Result<(), Error> {
+        let initial = self
+            .initial_device
+            .take()
+            .ok_or_else(|| std::io::Error::other("audio backend already started"))?;
+        let stop = self.stop.clone();
+        let (ready_tx, ready_rx) = mpsc::sync_channel(1);
+        self.worker = Some(
+            thread::Builder::new()
+                .name("ethornell-audio".into())
+                .spawn(move || {
+                    let renderer = Arc::new(Mutex::new(renderer));
+                    let mut stream = match open_stream(initial, &renderer) {
+                        Ok(stream) => {
+                            if ready_tx.send(Ok(())).is_err() {
+                                return;
+                            }
+                            Some(stream)
+                        }
+                        Err(error) => {
+                            let _ = ready_tx.send(Err(error));
+                            return;
+                        }
+                    };
+                    while !stop.load(Ordering::Acquire) {
+                        thread::park_timeout(RETRY_INTERVAL);
+                        if stop.load(Ordering::Acquire) {
+                            break;
+                        }
+                        if stream
+                            .as_ref()
+                            .is_some_and(|(_, failed)| failed.load(Ordering::Acquire))
+                        {
+                            // Never hold the mixer lock while closing a stream.
+                            // Oboe may wait for its last data callback to return.
+                            drop(stream.take());
+                        }
+                        if stream.is_none() {
+                            match output_device().and_then(|device| open_stream(device, &renderer)) {
+                                Ok(reopened) => stream = Some(reopened),
+                                Err(error) => eprintln!("audio reconnect deferred: {error}"),
+                            }
+                        }
+                    }
+                })?,
+        );
+        ready_rx
+            .recv()
+            .map_err(|_| std::io::Error::other("audio worker stopped during startup"))?
+    }
+}
+
+impl Drop for AndroidBackend {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        if let Some(worker) = self.worker.take() {
+            worker.thread().unpark();
+            let _ = worker.join();
+        }
+    }
+}
+
+fn output_device() -> Result<(Device, StreamConfig), Error> {
+    let device = cpal::default_host()
+        .default_output_device()
+        .ok_or_else(|| std::io::Error::other("no default audio output"))?;
+    let config = device.default_output_config()?.config();
+    Ok((device, config))
+}
+
+fn open_stream(
+    (device, config): (Device, StreamConfig),
+    renderer: &Arc<Mutex<Renderer>>,
+) -> Result<(Stream, Arc<AtomicBool>), Error> {
+    // The previous stream has been dropped before changing the mixer rate.
+    renderer
+        .lock()
+        .map_err(|_| std::io::Error::other("audio mixer lock poisoned"))?
+        .on_change_sample_rate(config.sample_rate.0);
+    let channels = usize::from(config.channels);
+    if channels == 0 {
+        return Err(std::io::Error::other("audio output has no channels").into());
+    }
+    // Each stream has its own flag, so a delayed callback from an old stream
+    // cannot disconnect its replacement.
+    let failed = Arc::new(AtomicBool::new(false));
+    let callback_failed = failed.clone();
+    let mixer = renderer.clone();
+    let stream = device.build_output_stream(
+        &config,
+        move |data: &mut [f32], _| {
+            data.fill(0.0);
+            let Ok(mut renderer) = mixer.try_lock() else {
+                return;
+            };
+            renderer.on_start_processing();
+            for frame in data.chunks_exact_mut(channels) {
+                let output = renderer.process();
+                if channels == 1 {
+                    frame[0] = (output.left + output.right) * 0.5;
+                } else {
+                    frame[0] = output.left;
+                    frame[1] = output.right;
+                }
+            }
+        },
+        move |_| callback_failed.store(true, Ordering::Release),
+        None,
+    )?;
+    stream.play()?;
+    Ok((stream, failed))
+}
